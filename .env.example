# Required in production. Use at least 24 random characters.
HOSTSYNC_SECRET=replace-with-a-long-random-secret

# file | sqlite | mysql
HOSTSYNC_STORAGE=file

# Optional CORS origin. Leave empty for same-origin usage.
HOSTSYNC_ALLOW_ORIGIN=

# File storage
HOSTSYNC_DATA_DIR=/absolute/path/outside/public_html/hostsync-storage

# SQLite
HOSTSYNC_SQLITE_PATH=/absolute/path/outside/public_html/hostsync.sqlite

# MySQL (when HOSTSYNC_STORAGE=mysql)
HOSTSYNC_MYSQL_DSN=mysql:host=127.0.0.1;dbname=hostsync;charset=utf8mb4
HOSTSYNC_MYSQL_USER=hostsync
HOSTSYNC_MYSQL_PASSWORD=change-me

HOSTSYNC_PUBLISH_LIMIT=120
